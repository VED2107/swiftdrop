# Self-hosting build of the SwiftDrop website for Yaploft Cloud. Vercel ignores this file.
# Builds apps/site (and the p2p web app it bundles) with pnpm, then serves the static output with nginx.
FROM node:24-bookworm-slim AS build
WORKDIR /src
RUN npm install -g pnpm@11.1.1 >/dev/null
COPY . .
ARG VITE_DOWNLOAD_URL
ARG VITE_ANDROID_URL
ENV VITE_DOWNLOAD_URL=$VITE_DOWNLOAD_URL VITE_ANDROID_URL=$VITE_ANDROID_URL
RUN pnpm install --frozen-lockfile --filter "@swiftdrop/site..." --filter "@swiftdrop/web..."
RUN cd apps/site && pnpm run build

FROM nginx:1.27-alpine
COPY apps/site/nginx.yaploft.conf /etc/nginx/conf.d/default.conf
COPY --from=build /src/apps/site/dist /usr/share/nginx/html
EXPOSE 80
