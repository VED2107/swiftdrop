{
  "name": "swiftdrop",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "packageManager": "pnpm@11.1.1",
  "engines": {
    "node": ">=20.10"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c cyan,magenta \"pnpm --filter @swiftdrop/server dev\" \"pnpm --filter @swiftdrop/web dev\"",
    "build": "pnpm --filter @swiftdrop/web build",
    "start": "pnpm build && pnpm --filter @swiftdrop/server start",
    "serve": "pnpm --filter @swiftdrop/server start",
    "typecheck": "tsc -p tsconfig.json && tsc -p apps/web/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "bench": "tsx tests/performance/bench.ts",
    "build:exe": "node scripts/build-exe.mjs",
    "bench:disk": "tsx tests/performance/disk-bench.ts",
    "bench:browser": "tsx tests/performance/browser-bench.ts",
    "bench:primitives": "tsx tests/performance/primitives.ts",
    "bench:check": "tsx tests/performance/bench.ts --check",
    "build:installer": "node scripts/build-installer.mjs",
    "build:icons": "node scripts/build-icons.mjs",
    "vectors": "tsx tests/vectors/generate.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@swiftdrop/crypto": "workspace:*",
    "@swiftdrop/protocol": "workspace:*",
    "@swiftdrop/server": "workspace:*",
    "@swiftdrop/shared": "workspace:*",
    "@swiftdrop/transfer-engine": "workspace:*",
    "@types/node": "^22.10.0",
    "@types/yauzl": "^2.10.3",
    "concurrently": "^9.1.0",
    "esbuild": "^0.25.0",
    "innosetup-compiler": "^6.3.1",
    "postject": "1.0.0-alpha.6",
    "rcedit": "^5.0.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "yauzl": "^3.2.0"
  }
}
